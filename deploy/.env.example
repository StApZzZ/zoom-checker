# ─────────────────────────────────────────────────────────────────────────────
#  Zoom Checker — настройки. Обязательны только PUBLIC_URL и секрет Zoom.
#  После изменения файла проверьте его от имени службы и перезапустите сервис:
#    sudo -u zoom-checker /usr/local/bin/zoom-checker check-config && sudo systemctl restart zoom-checker
#  В Docker: docker compose run --rm zoom-checker check-config && docker compose up -d
#  (и закройте файл от чужих глаз: chmod 600 .env — в нём пароли).
# ─────────────────────────────────────────────────────────────────────────────

# Адрес, по которому сервис открывается в браузере. От него строится адрес
# webhook для Zoom: <PUBLIC_URL>/api/webhooks/zoom
# Для Zoom нужен адрес с доменным именем: IP-адрес Zoom не примет (для проверки
# самого сервиса https://203.0.113.10 подойдёт, домен можно добавить позже).
PUBLIC_URL=https://attendance.example.com

# HTTPS:
#   auto — сервис сам получит бесплатный сертификат Let's Encrypt (нужны открытые
#          порты 80 и 443; сертификат выдаётся и на IP-адрес, но Zoom примет только домен);
#   off  — обычный HTTP на LISTEN_ADDR (если перед сервисом стоит nginx/Caddy/балансировщик);
#   file — свой сертификат: TLS_CERT_FILE и TLS_KEY_FILE (файлы должны читаться
#          пользователем zoom-checker: chown root:zoom-checker, chmod 0640; не в /home и /root).
#          Сервис сам отвечает по HTTPS на LISTEN_ADDR — обычно LISTEN_ADDR=:443.
#          В Docker пути указываются внутри контейнера (/certs/...), см. docs/admin-guide.md, раздел 4.
TLS_MODE=auto
#TLS_EMAIL=admin@example.com
#LISTEN_ADDR=:8080
#TLS_CERT_FILE=/etc/zoom-checker/tls.crt
#TLS_KEY_FILE=/etc/zoom-checker/tls.key

# Secret Token из приложения Zoom Marketplace (Feature → Secret Token).
ZOOM_WEBHOOK_SECRET_TOKEN=

# Часовой пояс сервиса: «сегодня», ночные задачи, время в сообщениях (с поясом, например
# «18:00 (UTC+3)»). Файлы Excel скачиваются по часовому поясу браузера. Если не указан — Europe/Moscow.
# install.sh сам подставит часовой пояс сервера (или спросит, если на сервере UTC).
#TIMEZONE=Europe/Moscow

# Первый администратор. Если пароль не задан — он будет сгенерирован и записан
# в файл initial-admin-password.txt в каталоге данных. После первого входа строку
# ADMIN_PASSWORD лучше удалить: она нужна только пока в базе нет ни одного пользователя.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=

# База данных. По умолчанию — встроенная SQLite в каталоге данных (ничего настраивать не нужно).
# Для PostgreSQL:
#DATABASE_URL=postgres://zoom_checker:password@db.example.com:5432/zoom_checker?sslmode=require
# В Docker с контейнером PostgreSQL из docker-compose.yml:
#COMPOSE_PROFILES=postgres
# Пароль — только латинские буквы и цифры (например: openssl rand -hex 24): символы @ / % и пробел
# ломают строку DATABASE_URL.
#POSTGRES_PASSWORD=
#DATABASE_URL=postgres://zoom_checker:<тот же пароль>@postgres:5432/zoom_checker?sslmode=disable

# Если сервис стоит за прокси — перечислите адреса прокси, чтобы в журналах были реальные IP
# (иначе ограничение попыток входа будет общим для всех пользователей).
#TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Через сколько после входа нужно войти снова (работа в сервисе срок не продлевает):
# локальные учётные записи / вход через Keycloak и AD (при новом входе роль и блокировка обновляются).
#SESSION_TTL=168h
#EXTERNAL_SESSION_TTL=24h

# ── Вход через Keycloak (OpenID Connect) ────────────────────────────────────
#OIDC_ISSUER_URL=https://sso.example.com/realms/edu
#OIDC_CLIENT_ID=zoom-checker
#OIDC_CLIENT_SECRET=
#OIDC_BUTTON_LABEL=Войти через корпоративный аккаунт
# Роли/группы Keycloak, дающие доступ (через запятую). "*" — пустить всех пользователей realm.
#OIDC_ADMIN_ROLES=zoom-checker-admin
#OIDC_TEACHER_ROLES=zoom-checker-teacher

# ── Вход через Active Directory / LDAP ──────────────────────────────────────
#LDAP_URL=ldaps://dc1.corp.example.com:636
#LDAP_PRESET=ad                      # ad | openldap | freeipa
#LDAP_BASE_DN=DC=corp,DC=example,DC=com
#LDAP_BIND_DN=CN=svc-zoom-checker,OU=Service,DC=corp,DC=example,DC=com
#LDAP_BIND_PASSWORD=
# Группы через ТОЧКУ С ЗАПЯТОЙ. "*" — пустить всех.
# Администраторов указывайте полным DN: просто имя группы совпадёт с группой с таким же именем
# в любом месте каталога. DN группы покажет: zoom-checker check-ldap --user ЛОГИН.
# Для преподавателей можно указать просто имя группы.
#LDAP_ADMIN_GROUPS=CN=ZoomChecker-Admins,OU=Groups,DC=corp,DC=example,DC=com
#LDAP_TEACHER_GROUPS=ZoomChecker-Teachers
#LDAP_START_TLS=false
#LDAP_CA_FILE=/etc/zoom-checker/corp-ca.pem

# Вход по локальным логинам/паролям (учётные записи создаёт администратор в интерфейсе).
#AUTH_LOCAL_ENABLED=true

# Журнал: debug | info | warn | error
#LOG_LEVEL=info
